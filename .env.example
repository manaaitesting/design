# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-me

# Optional: point the browser at a non-local sync server
# NEXT_PUBLIC_SYNC_URL=wss://sync.example.com

# Optional: powers the AI design assistant (the ✦ button in the editor).
# Without it the assistant falls back to built-in templates.
ANTHROPIC_API_KEY=
